[Desktop Entry]
Type=Application
Name=MCRAWsome
Comment=Develop MCRAW recordings for DaVinci Resolve
Exec=mcrawsome gui -- %F
Icon=mcrawsome
Terminal=false
Categories=AudioVideo;Video;
StartupNotify=true
MimeType=video/x-motioncam-raw;application/x-mcrawsome-session;video/mp4;video/quicktime;video/x-matroska;
Actions=library;settings;unmount-all;

[Desktop Action library]
Name=Library
Exec=mcrawsome gui --view library

[Desktop Action settings]
Name=Settings
Exec=mcrawsome gui --view settings

[Desktop Action unmount-all]
Name=Unmount All
Exec=mcrawsome unmount-all --notify
