<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="video/x-motioncam-raw">
    <comment>MotionCam RAW recording</comment>
    <glob pattern="*.mcraw"/>
    <generic-icon name="video-x-generic"/>
  </mime-type>
  <!-- Only names ending .mcrawsome-session.json: other JSON files keep their own applications. -->
  <mime-type type="application/x-mcrawsome-session">
    <comment>MCRAWsome session</comment>
    <sub-class-of type="application/json"/>
    <glob pattern="*.mcrawsome-session.json"/>
  </mime-type>
</mime-info>
